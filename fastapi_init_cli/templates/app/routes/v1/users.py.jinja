from fastapi import APIRouter, Depends
{% if is_async %}
from sqlalchemy.ext.asyncio import AsyncSession
{% else %}
from sqlalchemy.orm import Session
{% endif %}

from app.core.database import get_db
from app.core.dependencies import get_current_user
from app.models.user import User
from app.schemas.user import UserRead, UserUpdate
from app.services.user_service import UserService

router = APIRouter()


@router.get("/me", response_model=UserRead, summary="Get Current User")
async def get_current_user_profile(
    current_user: User = Depends(get_current_user),
) -> User:
    """Retrieve profile details for the authenticated user."""
    return current_user


@router.patch("/me", response_model=UserRead, summary="Update Current User")
async def update_current_user_profile(
    user_in: UserUpdate,
    current_user: User = Depends(get_current_user),
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> User:
    """Update profile information for the authenticated user."""
    user_service = UserService(db)
{% if is_async %}
    updated_user = await user_service.update(current_user, user_in)
{% else %}
    updated_user = user_service.update(current_user, user_in)
{% endif %}
    return updated_user
