from fastapi import APIRouter, Depends, HTTPException, status
{% if is_async %}
from sqlalchemy.ext.asyncio import AsyncSession
{% else %}
from sqlalchemy.orm import Session
{% endif %}

from app.core.database import get_db
from app.models.user import User
from app.schemas.auth import (
    LoginRequest,
    RefreshTokenRequest,
    Token,
{% if include_google_oauth %}
    GoogleAuthUrlResponse,
    GoogleLoginResponse,
{% endif %}
)
from app.schemas.user import UserCreate, UserRead
{% if needs_otp_model %}
from app.schemas.otp import (
    MessageResponse,
{% if include_email_verification %}
    VerifyEmailRequest,
    ResendOTPRequest,
{% endif %}
{% if include_forgot_password %}
    ForgotPasswordRequest,
    ResetPasswordRequest,
{% endif %}
)
{% endif %}
from app.services.auth_service import AuthService
from app.services.user_service import UserService
{% if needs_otp_model %}
from app.services.otp_service import OTPService
{% endif %}
{% if needs_email_service %}
from app.services.email_service import EmailService
{% endif %}

router = APIRouter()


@router.post("/register", response_model=UserRead, status_code=status.HTTP_201_CREATED, summary="Register User")
async def register(
    user_in: UserCreate,
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> User:
    """Register a new user account."""
    auth_service = AuthService(db)
{% if include_email_verification %}
    # If email verification is enabled, create user unverified and dispatch OTP
    {% if is_async %}
    user = await auth_service.register(user_in, is_verified=False)
    otp_service = OTPService(db)
    otp = await otp_service.create_otp(user.id, user.email, purpose="email_verification")
    {% else %}
    user = auth_service.register(user_in, is_verified=False)
    otp_service = OTPService(db)
    otp = otp_service.create_otp(user.id, user.email, purpose="email_verification")
    {% endif %}
    EmailService.send_verification_otp(user.email, otp.otp_code)
{% else %}
    {% if is_async %}
    user = await auth_service.register(user_in, is_verified=True)
    {% else %}
    user = auth_service.register(user_in, is_verified=True)
    {% endif %}
{% endif %}
    return user


@router.post("/login", response_model=Token, summary="Login")
async def login(
    login_data: LoginRequest,
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> Token:
    """Authenticate user with email and password to receive JWT tokens."""
    auth_service = AuthService(db)
{% if is_async %}
    user = await auth_service.authenticate(login_data.email, login_data.password)
{% else %}
    user = auth_service.authenticate(login_data.email, login_data.password)
{% endif %}
    if not user:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Incorrect email or password",
        )
    return auth_service.generate_tokens(user.id)


@router.post("/refresh", response_model=Token, summary="Refresh Token")
async def refresh_token(
    refresh_data: RefreshTokenRequest,
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> Token:
    """Exchange a valid refresh token for a new access token."""
    auth_service = AuthService(db)
{% if is_async %}
    return await auth_service.refresh_tokens(refresh_data.refresh_token)
{% else %}
    return auth_service.refresh_tokens(refresh_data.refresh_token)
{% endif %}
{% if include_email_verification %}


@router.post("/verify-email", response_model=MessageResponse, summary="Verify Email Address")
async def verify_email(
    verify_data: VerifyEmailRequest,
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> MessageResponse:
    """Verify user account email with OTP code."""
    otp_service = OTPService(db)
    user_service = UserService(db)

{% if is_async %}
    otp = await otp_service.verify_otp(
        email=verify_data.email,
        otp_code=verify_data.otp_code,
        purpose="email_verification",
    )
    if not otp:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid or expired verification code",
        )
    user = await user_service.get_by_id(otp.user_id)
    if not user:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="User not found")

    await user_service.mark_verified(user)
{% else %}
    otp = otp_service.verify_otp(
        email=verify_data.email,
        otp_code=verify_data.otp_code,
        purpose="email_verification",
    )
    if not otp:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid or expired verification code",
        )
    user = user_service.get_by_id(otp.user_id)
    if not user:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="User not found")

    user_service.mark_verified(user)
{% endif %}
    return MessageResponse(message="Email successfully verified.")


@router.post("/resend-verification-otp", response_model=MessageResponse, summary="Resend Verification OTP")
async def resend_verification_otp(
    resend_data: ResendOTPRequest,
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> MessageResponse:
    """Resend a new email verification code."""
    user_service = UserService(db)
    otp_service = OTPService(db)

{% if is_async %}
    user = await user_service.get_by_email(resend_data.email)
    if user and not user.is_verified:
        otp = await otp_service.create_otp(user.id, user.email, purpose="email_verification")
        EmailService.send_verification_otp(user.email, otp.otp_code)
{% else %}
    user = user_service.get_by_email(resend_data.email)
    if user and not user.is_verified:
        otp = otp_service.create_otp(user.id, user.email, purpose="email_verification")
        EmailService.send_verification_otp(user.email, otp.otp_code)
{% endif %}
    return MessageResponse(message="If the account exists and is unverified, a new OTP code has been sent.")
{% endif %}
{% if include_forgot_password %}


@router.post("/forgot-password", response_model=MessageResponse, summary="Request Password Reset")
async def forgot_password(
    data: ForgotPasswordRequest,
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> MessageResponse:
    """Request a password reset OTP code."""
    user_service = UserService(db)
    otp_service = OTPService(db)

{% if is_async %}
    user = await user_service.get_by_email(data.email)
    if user:
        otp = await otp_service.create_otp(user.id, user.email, purpose="password_reset")
        EmailService.send_password_reset_otp(user.email, otp.otp_code)
{% else %}
    user = user_service.get_by_email(data.email)
    if user:
        otp = otp_service.create_otp(user.id, user.email, purpose="password_reset")
        EmailService.send_password_reset_otp(user.email, otp.otp_code)
{% endif %}
    return MessageResponse(message="If the email exists, a password reset code has been sent.")


@router.post("/reset-password", response_model=MessageResponse, summary="Reset Password with OTP")
async def reset_password(
    data: ResetPasswordRequest,
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> MessageResponse:
    """Reset password using OTP code."""
    otp_service = OTPService(db)
    user_service = UserService(db)

{% if is_async %}
    otp = await otp_service.verify_otp(
        email=data.email,
        otp_code=data.otp_code,
        purpose="password_reset",
    )
    if not otp:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid or expired reset code",
        )
    user = await user_service.get_by_id(otp.user_id)
    if not user:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="User not found")

    await user_service.update_password(user, data.new_password)
{% else %}
    otp = otp_service.verify_otp(
        email=data.email,
        otp_code=data.otp_code,
        purpose="password_reset",
    )
    if not otp:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid or expired reset code",
        )
    user = user_service.get_by_id(otp.user_id)
    if not user:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="User not found")

    user_service.update_password(user, data.new_password)
{% endif %}
    return MessageResponse(message="Password has been successfully reset. You can now log in.")
{% endif %}
{% if include_google_oauth %}


@router.get("/google/login", response_model=GoogleAuthUrlResponse, summary="Google OAuth URL")
def google_login() -> GoogleAuthUrlResponse:
    """Retrieve Google OAuth 2.0 consent URL."""
    auth_url = AuthService.get_google_auth_url()
    return GoogleAuthUrlResponse(auth_url=auth_url)


@router.get("/google/callback", response_model=GoogleLoginResponse, summary="Google OAuth Callback")
async def google_callback(
    code: str,
    db: {% if is_async %}AsyncSession{% else %}Session{% endif %} = Depends(get_db),
) -> GoogleLoginResponse:
    """Exchange Google OAuth code for application access & refresh tokens."""
    auth_service = AuthService(db)
{% if is_async %}
    tokens, is_new_user = await auth_service.handle_google_callback(code)
{% else %}
    tokens, is_new_user = auth_service.handle_google_callback(code)
{% endif %}
    return GoogleLoginResponse(
        access_token=tokens.access_token,
        refresh_token=tokens.refresh_token,
        token_type=tokens.token_type,
        is_new_user=is_new_user,
    )
{% endif %}
