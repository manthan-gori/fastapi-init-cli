import secrets
from datetime import datetime, timedelta, timezone
from typing import Optional
from sqlalchemy import select, and_
{% if is_async %}
from sqlalchemy.ext.asyncio import AsyncSession
{% else %}
from sqlalchemy.orm import Session
{% endif %}

from app.core.config import settings
from app.models.otp import OTP


class OTPService:
    """Service for generating, storing, and validating One-Time Passwords."""

    def __init__(self, db: {% if is_async %}AsyncSession{% else %}Session{% endif %}) -> None:
        self.db = db

    @staticmethod
    def generate_otp_code(length: int = 6) -> str:
        """Generate a cryptographically secure numeric OTP."""
        return "".join(secrets.choice("0123456789") for _ in range(length))

{% if is_async %}
    async def create_otp(self, user_id: int, email: str, purpose: str) -> OTP:
        """Create and persist a new OTP record."""
        otp_code = self.generate_otp_code()
        expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.OTP_EXPIRE_MINUTES)
        
        otp = OTP(
            user_id=user_id,
            email=email.lower(),
            otp_code=otp_code,
            purpose=purpose,
            expires_at=expires_at,
            is_used=False,
        )
        self.db.add(otp)
        await self.db.commit()
        await self.db.refresh(otp)
        return otp

    async def verify_otp(self, email: str, otp_code: str, purpose: str) -> Optional[OTP]:
        """Validate an OTP code; returns the OTP model if valid and marks it used."""
        result = await self.db.execute(
            select(OTP)
            .where(
                and_(
                    OTP.email == email.lower(),
                    OTP.otp_code == otp_code,
                    OTP.purpose == purpose,
                    OTP.is_used == False,  # noqa: E712
                )
            )
            .order_by(OTP.created_at.desc())
        )
        otp = result.scalars().first()
        if not otp:
            return None

        if otp.is_expired():
            return None

        otp.is_used = True
        self.db.add(otp)
        await self.db.commit()
        return otp
{% else %}
