from pydantic import BaseModel, EmailStr, Field


class VerifyEmailRequest(BaseModel):
    email: EmailStr = Field(..., examples=["jane.doe@example.com"])
    otp_code: str = Field(..., min_length=6, max_length=6, description="6-digit verification code")


class ResendOTPRequest(BaseModel):
    email: EmailStr = Field(..., examples=["jane.doe@example.com"])


class ForgotPasswordRequest(BaseModel):
    email: EmailStr = Field(..., examples=["jane.doe@example.com"])


class ResetPasswordRequest(BaseModel):
    email: EmailStr = Field(..., examples=["jane.doe@example.com"])
    otp_code: str = Field(..., min_length=6, max_length=6, description="6-digit reset code")
    new_password: str = Field(..., min_length=8, max_length=128, description="New password (min 8 characters)", examples=["new_password"])


class MessageResponse(BaseModel):
    message: str
